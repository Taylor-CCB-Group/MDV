{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "assist": { "actions": { "source": { "organizeImports": "on" } } },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "complexity": {
                "useLiteralKeys": "off",
                "noForEach": "off",
                "noUselessSwitchCase": "info",
                "noUselessFragments": "off",
                "noArguments": "off"
            },
            "suspicious": {
                "noExplicitAny": "off",
                "noImplicitAnyLet": "off",
                "noAssignInExpressions": "off",
                "noPrototypeBuiltins": "off"
            },
            "correctness": {
                "useExhaustiveDependencies": "info",
                "noSwitchDeclarations": "info"
            },
            "style": {
                "useNumberNamespace": "info",
                "noParameterAssign": "off",
                "useTemplate": "info",
                "useSingleVarDeclarator": "info",
                "noUselessElse": "off"
            },
            "a11y": {
                "useKeyWithClickEvents": "off",
                "noSvgWithoutTitle": "off"
            },
            "performance": {
                "noDelete": "info"
            }
        }
    },
    "overrides": [
        {
            // legacy stylesheet overriding third-party (slickgrid, jquery-ui) styles; relies on !important and source order
            "includes": ["src/charts/css/**"],
            "linter": {
                "rules": {
                    "complexity": { "noImportantStyles": "off" },
                    "style": { "noDescendingSpecificity": "off" }
                }
            }
        }
    ],
    "css": { "parser": { "tailwindDirectives": true } },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4, // considering changing to 2, but most of the codebase uses 4
        "lineWidth": 120
    },
    "files": {
        // todo - fix other code and remove these ignores (notwithstanding legacy)
        "includes": [
            "**",
            "!src/legacy/**/*",
            "!src/browser/**/*",
            "!src/table/Slick*",
            "!src/venn/**/*",
            "!src/table/css/slick*",
            "!src/utilities/css/**/*",
            "!src/css/**/*",
            "!src/utilities/jpeg2000/chafey/**/*",
            // vendored coi-serviceworker
            "!public/serviceworker.js",
            "!python/mdvtools/templates/serviceworker.js"
        ]
    }
}
