{
  "uid": "mdv-browser",
  "title": "MDV browser",
  "description": "What people wait for in the browser: page loads, spatial charts, request times and errors, from Faro.",
  "tags": [
    "mdv"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({source=\"faro\"}, app_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "allValue": null,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 1,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "p75 largest paint",
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Largest Contentful Paint: when the biggest element on the page appeared. Good is under 2.5 seconds.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.75, {source=\"faro\", kind=\"measurement\", app_name=~\"$app\"} | logfmt | type=\"web-vitals\" | lcp!=\"\" | unwrap lcp [$__range]) by (source)",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2500
              },
              {
                "color": "red",
                "value": 4000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "p75 interaction delay",
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
