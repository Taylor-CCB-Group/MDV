          "expr": "quantile_over_time(0.75, {source=\"faro\", kind=\"measurement\", app_name=~\"$app\"} | logfmt | type=\"web-vitals\" | ttfb!=\"\" | unwrap ttfb [$__auto]) by (app_name)",
          "refId": "A",
