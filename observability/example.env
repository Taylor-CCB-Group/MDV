# Grafana's admin sign-in. Required.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Optional. When set, Alloy accepts browser telemetry only from MDV servers
# that send the same value, set as FARO_API_KEY on each MDV deployment.
FARO_API_KEY=

# Ports on 127.0.0.1. Change them if something else already uses them.
GRAFANA_PORT=3000
ALLOY_UI_PORT=12345

PROMETHEUS_RETENTION=30d
