// Alloy collects everything on this server and sends it to Loki, Prometheus and Tempo.
//
// - Container logs: every container on the host, read through the Docker socket.
// - Container and host metrics: cAdvisor and the unix (node) exporter.
// - OpenTelemetry from MDV servers: OTLP on 4317 (gRPC) and 4318 (HTTP).
// - Browser telemetry: the Faro receiver on 12347, which MDV forwards to.
//
// None of these ports is published outside the mdv-telemetry network.

// ---------------------------------------------------------------------------
// Container logs
// ---------------------------------------------------------------------------

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.containers.receiver]
}

loki.process "containers" {
  // The stack's own logs stay in `docker compose logs`, so Loki does not
  // store a record of itself storing records.
  stage.drop {
    source = "compose_project"
    value  = "mdv-observability"
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ---------------------------------------------------------------------------
// Container and host metrics
// ---------------------------------------------------------------------------

prometheus.exporter.cadvisor "containers" {
  docker_only                  = true
  store_container_labels       = false
  allowlisted_container_labels = [
    "com.docker.compose.project",
    "com.docker.compose.service",
  ]
}

prometheus.scrape "containers" {
  targets         = prometheus.exporter.cadvisor.containers.targets
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
}

prometheus.exporter.unix "host" {
  procfs_path = "/rootproc"
  sysfs_path  = "/sys"
  rootfs_path = "/rootfs"
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// ---------------------------------------------------------------------------
// OpenTelemetry from MDV servers
// ---------------------------------------------------------------------------

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}

// ---------------------------------------------------------------------------
// Browser telemetry (Faro), forwarded by MDV
// ---------------------------------------------------------------------------

faro.receiver "browser" {
  server {
    listen_address           = "0.0.0.0"
    listen_port              = 12347
    // When set, only clients that send this value in X-API-Key are accepted.
    // MDV adds it when it forwards a browser's payload.
    api_key                  = sys.env("FARO_API_KEY")
    max_allowed_payload_size = "1MiB"

    rate_limiting {
      strategy   = "per_app"
      rate       = 50
      burst_size = 100
    }
  }

  // Downloading sourcemaps makes Alloy fetch any URL a client names.
  sourcemaps {
    download = false
  }

  extra_log_labels = {
    source = "faro",
  }

  output {
    logs   = [loki.process.browser.receiver]
    traces = [otelcol.processor.batch.default.input]
  }
}

// Faro writes each item as a logfmt line with no stream labels. Promote the
// deployment's app name and the item kind (measurement, log, exception, event)
// so dashboards can select them. Both have few distinct values.
loki.process "browser" {
  stage.logfmt {
    mapping = {
      app_name = "",
      kind     = "",
    }
  }

  stage.labels {
    values = {
      app_name = "",
      kind     = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}
